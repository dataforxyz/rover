# ============================================================
# rover-pipeline.env — Per-project pipeline configuration
# ============================================================
# Place this file as `rover-pipeline.env` in your project root,
# or point to it with ROVER_PIPELINE_CONFIG=/path/to/file.env
#
# Empty/unset steps are skipped. Only STEP_SHIP is required
# for the pipeline to produce a shipped result.
#
# Command templates support {placeholder} variables:
#   {task_id}     - Task identifier
#   {branch}      - Git branch name
#   {title}       - Task title (may contain special chars)
#   {project_dir} - Project root directory
#   {worktree}    - Git worktree path
#   {issue_num}   - Issue number (if linked)
#   {issue_url}   - Issue URL (if linked)
#   {pr_url}      - Pull/merge request URL (if exists)
#   {data_dir}    - Pipeline data directory
#   {log_dir}     - Pipeline log directory
# ============================================================

# --- Git Forge ---
# Auto-detected from git remote URL. Override: "gh" (GitHub) or "glab" (GitLab)
GIT_FORGE=gh

# Auto-detected from remote HEAD. Override: "main", "master", or "rover-landing"
# Set to "rover-landing" for a landing-zone strategy where agents merge into
# "rover-landing" and humans promote to "main" via PR.
DEFAULT_BRANCH=rover-landing

# --- AI Provider ---
# Which AI CLI to use: "claude" (default) or "codex" (OpenAI Codex CLI with gpt5.3)
AI_PROVIDER=codex

# --- Task Source ---
# Adapter for the task management system. Currently: "rover"
TASK_SOURCE=rover

# Agent used for AI-assisted rebase conflict resolution.
# Leave empty to auto-detect from AI_PROVIDER (claude→claude:sonnet, codex→codex:gpt5.3).
REBASE_AGENT=

# --- Pipeline Steps ---
# Each STEP_* is a shell command template. Leave empty to skip.

# PR preparation: security scan + autofix (runs before merge lock)
# Exit 0 = passed. Output "Sending back to rover" = iterate.
# Can write state files: pr_ready_state_{task_id}, pr_ready_autofix_diff_{task_id}
STEP_PR_READY=./scripts/pr_ready.sh {worktree}

# Health check: verify services are running (runs before merge lock)
# Exit 0 = healthy. Any non-zero = fail.
STEP_HEALTH_CHECK=./scripts/health_check.sh

# Security scan after AI rebase conflict resolution
# Only runs when rebase had AI-resolved conflicts
STEP_SECURITY_SCAN=./scripts/security_scan.sh {worktree}

# Test selection: stdout = space-separated test file paths
STEP_TEST_SELECT=./scripts/select_tests.sh {worktree}

# Test runner: selected tests appended as extra args
# Exit 0 = passed. Output "BASELINE_CRASH" = infra error.
# Output "New failures:" section = failure details.
STEP_TEST=./scripts/test.sh {worktree}

# Fallback test list when STEP_TEST_SELECT returns empty
TEST_FALLBACK=test/

# Code review: exit 0 = approved, exit 1 = rejected
# On rejection, stdout should be JSON: {"comments": "..."}
STEP_CODE_REVIEW=./scripts/code_review.sh {worktree} {branch}

# Ship: merge branch into default branch (REQUIRED for pipeline to complete)
# Exit 0 = shipped. Exit 2 = merge conflict (triggers retry from rebase).
STEP_SHIP=./scripts/ship.sh {worktree}

# --- Dependency Management ---
# Comma-separated filenames. If any change after rebase, INSTALL_CMD runs.
WATCH_INSTALL_FILES=package.json,package-lock.json
INSTALL_CMD=npm ci

# --- Backup ---
# Snapshot each target repo before the pipeline modifies it.
# Creates a git bundle in {data_dir}/backups/{repo_name}/.
# Enabled by default. Set to "false" to disable.
# Skips when changes are purely additive (new refs only).
# Triggers backup on any deleted or rewritten (force-pushed) ref.
# Uses tiered retention: recent (<1d) + medium (1-7d, 1 kept) + old (7d+, 1 kept).
BACKUP_ENABLED=true
BACKUP_DIR=
BACKUP_MIRROR_REMOTE=
BACKUP_TIMEOUT=300
# Number of recent (<1 day old) bundles to keep. Tiered retention also keeps
# 1 medium-age (1-7 days) and 1 old (7+ days) bundle automatically.
# Set to 0 to disable pruning entirely.
BACKUP_KEEP=3

# --- Timeouts (seconds) ---
SHIP_TIMEOUT=180
REVIEW_TIMEOUT=120

# --- Worker Limits ---
ROVER_MAX_WORKERS=3
ROVER_MAX_ITERATIONS=3
MAX_DIFF_CHARS=8000

# --- Cleanup ---
# Run rover cleanup + Docker prune after every N completed tasks (0 to disable)
CLEANUP_EVERY_N_TASKS=5

# --- Notifications ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
DISCORD_USER_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Issue Intake ---
ISSUE_LABEL=rover
ISSUE_STARTED_LABEL=rover-started
ISSUE_STUCK_LABEL=rover-stuck
# Leave empty to auto-detect from AI_PROVIDER.
VALID_AGENTS=
VALID_WORKFLOWS=swe-tdd,swe,tech-writer
VALID_PRIORITIES=critical,high,medium,low
# Leave empty to auto-detect forge (github/gitlab) and use default source branch.
# Override for custom commands or non-standard branch names.
# Example (GitHub):  rover task -s master -a {agent} -w {workflow} --context github:issue/{issue_num} --context-trust-all-authors
# Example (GitLab):  rover task -s main -a {agent} -w {workflow} --context gitlab:issue/{issue_num} --context-trust-all-authors
INTAKE_TASK_CMD=
INTAKE_MAX_RUNNING=2
INTAKE_MAX_COMPLETED=1
