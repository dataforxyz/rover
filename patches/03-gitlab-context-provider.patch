+
+    it('should detect repo from git remote when not in URI', async () => {
+      MockGit.mockImplementation(
+        () =>
+          ({
+            remoteUrl: vi.fn().mockReturnValue('git@gitlab.com:owner/repo.git'),
+          }) as unknown as Git
+      );
+
+      const issueResponse = {
+        iid: 15,
+        title: 'Test Issue',
