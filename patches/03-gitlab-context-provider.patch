+          } as ReturnType<typeof launchSync>;
+        }
+        return { exitCode: 1 } as ReturnType<typeof launchSync>;
+      });
+
+      const provider = new GitLabProvider(
+        new URL('gitlab:explicit/repo/issue/15'),
