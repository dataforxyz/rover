+
+      mockLaunchSync.mockImplementation((cmd, args) => {
+        if (cmd === 'glab' && args?.[0] === '--version') {
+          return { exitCode: 0 } as ReturnType<typeof launchSync>;
+        }
+        if (cmd === 'glab' && args?.[0] === 'issue' && args?.[1] === 'view') {
