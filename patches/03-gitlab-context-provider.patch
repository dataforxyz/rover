-const getGitHubRepoInfo = (
-  remoteUrl: string
-): { owner: string; repo: string } | null => {
-  // Handle various GitHub URL formats
-  const patterns = [
-    /github[^:/]*[:/]([^/]+)\/([^/.]+)(\.git)?$/,
