+      return 'rover-agent-local:latest';
     } else {
       return `ghcr.io/endorhq/rover/agent:v${version}`;
     }
   } catch (_err) {
-    return 'ghcr.io/endorhq/rover/agent-dev:latest';
+    return 'rover-agent-local:latest';
