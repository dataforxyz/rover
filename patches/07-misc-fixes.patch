From 56048647d54bca6883284d8bd4202b3377bb2046 Mon Sep 17 00:00:00 2001
From: Ben U <dataforxyz@gmail.com>
Date: Thu, 26 Feb 2026 19:16:05 -0600
Subject: [PATCH] fix: clamp progress bar fill to prevent negative repeat count

When progress exceeds 100%, Math.round could produce a filled count
greater than barLength, making barLength - filled negative and crashing
String.repeat with RangeError: Invalid count value: -1.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 packages/cli/src/commands/list.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/cli/src/commands/list.ts b/packages/cli/src/commands/list.ts
index 41ed678..a3a6360 100644
--- a/packages/cli/src/commands/list.ts
+++ b/packages/cli/src/commands/list.ts
@@ -58,7 +58,7 @@ const formatProgress = (step?: string, progress?: number): string => {
   if (step === undefined || progress === undefined) return colors.gray('─────');
 
   const barLength = 8;
-  const filled = Math.round((progress / 100) * barLength);
+  const filled = Math.max(0, Math.min(barLength, Math.round((progress / 100) * barLength)));
   const bar = '█'.repeat(filled) + '░'.repeat(barLength - filled);
 
   if (step === 'FAILED') {
-- 
2.53.0

From bbf0689d8a1c568858bb28874c76cc293db36b05 Mon Sep 17 00:00:00 2001
From: Ben U <dataforxyz@gmail.com>
Date: Thu, 26 Feb 2026 19:43:33 -0600
Subject: [PATCH] fix: use bash and source .profile in command runner for
 proper PATH setup

Switch command runner from sh to bash and source ~/.profile before
executing commands so language-specific PATH additions (Go, Python, Rust)
are available. Also use local agent image for dev builds and add go
binary accessibility verification in sandbox setup.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 .../src/lib/__tests__/command-runner.test.ts  | 21 +++++++++++++------
 packages/agent/src/lib/command-runner.ts      | 10 +++++++--
 packages/cli/src/commands/list.ts             |  5 ++++-
 .../cli/src/lib/sandbox/container-common.ts   |  6 +++---
 packages/cli/src/lib/sandbox/languages/go.ts  | 10 ++++++++-
 5 files changed, 39 insertions(+), 13 deletions(-)

diff --git a/packages/agent/src/lib/__tests__/command-runner.test.ts b/packages/agent/src/lib/__tests__/command-runner.test.ts
index 3985c63..e1c47ce 100644
--- a/packages/agent/src/lib/__tests__/command-runner.test.ts
+++ b/packages/agent/src/lib/__tests__/command-runner.test.ts
@@ -215,8 +215,11 @@ describe('runCommandStep', () => {
     await runCommandStep(step, new Map(), new Map(), 60);
 
     expect(mockedLaunch).toHaveBeenCalledWith(
-      'sh',
-      ['-c', 'sleep 1'],
+      'bash',
+      [
+        '-c',
+        '[ -f "$HOME/.profile" ] && . "$HOME/.profile" 2>/dev/null; sleep 1',
+      ],
       expect.objectContaining({ timeout: 60_000 })
     );
   });
@@ -244,8 +247,11 @@ describe('runCommandStep', () => {
 
     // Default is 300 seconds = 300_000 ms
     expect(mockedLaunch).toHaveBeenCalledWith(
-      'sh',
-      ['-c', 'echo hi'],
+      'bash',
+      [
+        '-c',
+        '[ -f "$HOME/.profile" ] && . "$HOME/.profile" 2>/dev/null; echo hi',
+      ],
       expect.objectContaining({ timeout: 300_000 })
     );
   });
@@ -278,8 +284,11 @@ describe('runCommandStep', () => {
 
     // Command runs through shell; args are shell-escaped
     expect(mockedLaunch).toHaveBeenCalledWith(
-      'sh',
-      ['-c', "npm test '--filter' 'unit'"],
+      'bash',
+      [
+        '-c',
+        '[ -f "$HOME/.profile" ] && . "$HOME/.profile" 2>/dev/null; npm test \'--filter\' \'unit\'',
+      ],
       expect.objectContaining({ reject: false })
     );
   });
diff --git a/packages/agent/src/lib/command-runner.ts b/packages/agent/src/lib/command-runner.ts
